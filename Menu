FlyBtn.MouseButton1Click:Connect(function()
    flying = not flying
    FlyBtn.Text = "Fly: " .. (flying and "ON" or "OFF")
    FlyBtn.TextColor3 = flying and Color3.fromRGB(0, 255, 150) or Color3.new(1, 1, 1)
    
    local char = player.Character
    local hum = char:WaitForChild("Humanoid")
    local root = char:WaitForChild("HumanoidRootPart")
    
    if flying then
        local bv = Instance.new("BodyVelocity", root)
        bv.Name = "FlyBV"
        bv.MaxForce = Vector3.new(1, 1, 1) * math.huge
        bv.Velocity = Vector3.new(0, 0, 0)
        
        local bg = Instance.new("BodyGyro", root)
        bg.Name = "FlyBG"
        bg.MaxTorque = Vector3.new(1, 1, 1) * math.huge
        bg.P = 10000
        bg.CFrame = root.CFrame
        
        hum.PlatformStand = true
        
        spawn(function()
            while flying do
                wait()
                -- Voa na direção que a câmera aponta usando o WalkSpeed atual
                bv.Velocity = game.Workspace.CurrentCamera.CFrame.LookVector * hum.WalkSpeed
                bg.CFrame = game.Workspace.CurrentCamera.CFrame
            end
            bv:Destroy()
            bg:Destroy()
            hum.PlatformStand = false
        end)
    end
end)

